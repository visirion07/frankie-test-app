# Publishable key of the Frankie workspace (public, safe in the browser).
# Find it in Frankie → your workspace → Keys & settings.
VITE_FRANKIE_KEY=
# Optional page agents.
VITE_FRANKIE_KEY_SUPPORT=
VITE_FRANKIE_KEY_DOCS=

# Server only. Signs the signed-in user's token. Never prefix it with VITE_.
# Copy it from Frankie → Keys & settings into .env.local (and Vercel env), never commit it.
FRANKIE_JWT_SECRET=
